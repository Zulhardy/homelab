# Managed by Ansible (homelab repo). Based on the unit created by the official k3s install script.
[Unit]
Description=Lightweight Kubernetes (k3s {{ k3s_role }})
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Service]
Type={{ 'notify' if k3s_role == 'server' else 'exec' }}
EnvironmentFile=-/etc/default/%N
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s {{ k3s_role }}

[Install]
WantedBy=multi-user.target
